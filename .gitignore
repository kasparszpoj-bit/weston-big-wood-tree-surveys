# Environment
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/

# Client data. AWT's survey data is unpublished and not ours to distribute.
# This stays ignored PERMANENTLY so it can never enter git history, even if
# the repo later goes public.
data/raw/*
!data/raw/.gitkeep

# Downloaded open data: regenerated by scripts/01_download_boundaries.py.
data/external/*
!data/external/.gitkeep

# Processed intermediates: rebuilt by the pipeline.
data/processed/*
!data/processed/.gitkeep

# Figures and tables ARE tracked (they are the point of the repo).
# The assembled HTML report is rebuilt by script 03, so it is not.
outputs/report.html

# Word working files. The report is shared as PDF only: .docx carries revision
# history and author metadata, and Word leaves lock files behind.
*.docx
~$*
~WRL*.tmp

# Contains client contact details and correspondence. Never commit.
access_and_admin.md

# Editors and OS
.vscode/
.idea/
.ipynb_checkpoints/
Thumbs.db
desktop.ini
